---
import SiteLayout from '../layouts/SiteLayout.astro';
import { frontmatter as copy } from '../../docs/CONTACT-EDITORIAL-MASTER.md';
import '../styles/editorial-internal.css';
import '../styles/contact.css';

const fields = copy.fields;
---
<SiteLayout title={copy.title} description={copy.intro} page="contact">
  <section class="inquiry-page" aria-labelledby="inquiry-title">
    <header class="inquiry-opening inner-wrap">
      <span class="section-label"><span class="gold-line" aria-hidden="true"></span>{copy.label}</span>
      <h1 id="inquiry-title" class="inner-display">{copy.opening}<br/><em>{copy.openingEmphasis}</em></h1>
      <p>{copy.intro} {copy.copy}</p>
    </header>
    <div class="inquiry-body">
      <h2 id="inquiry-form-title">{copy.formTitle}</h2>
      <p class="inquiry-disclosure" id="contact-disclosure">{copy.disclosure}</p>
      <p class="inquiry-hint">{copy.formHint}</p>
      <form method="dialog" aria-labelledby="inquiry-form-title" aria-describedby="contact-disclosure">
        <div class="inquiry-fields">
          <div class="inquiry-field inquiry-field--full">
            <label for="inquiry-name">{fields.name}</label>
            <input id="inquiry-name" type="text" autocomplete="name" required />
          </div>
          <div class="inquiry-field">
            <label for="inquiry-email">{fields.email}</label>
            <input id="inquiry-email" type="email" autocomplete="email" required />
          </div>
          <div class="inquiry-field">
            <label for="inquiry-phone">{fields.phone} <span>(optional)</span></label>
            <input id="inquiry-phone" type="tel" autocomplete="tel" />
          </div>
          <div class="inquiry-field">
            <label for="inquiry-type">{fields.type}</label>
            <select id="inquiry-type" required>
              <option value="">Select an occasion</option>
              {copy.options.map((option) => <option>{option}</option>)}
            </select>
          </div>
          <div class="inquiry-field">
            <label for="inquiry-date">{fields.date} <span>(optional)</span></label>
            <input id="inquiry-date" type="date" />
          </div>
          <div class="inquiry-field">
            <label for="inquiry-location">{fields.location} <span>(optional)</span></label>
            <input id="inquiry-location" type="text" />
          </div>
          <div class="inquiry-field">
            <label for="inquiry-guests">{fields.guests} <span>(optional)</span></label>
            <input id="inquiry-guests" type="number" min="1" step="1" inputmode="numeric" />
          </div>
          <div class="inquiry-field inquiry-field--full">
            <label for="inquiry-vision">{fields.vision}</label>
            <textarea id="inquiry-vision" rows="5" required></textarea>
          </div>
        </div>
        <button type="button" class="ab-btn ab-directional inquiry-disabled" data-ab-directional data-ab-side="left" disabled aria-describedby="contact-disclosure">
          <span class="ab-directional__fill" aria-hidden="true"></span>
          <span class="ab-directional__inner">{copy.status}</span>
        </button>
      </form>
    </div>
  </section>
</SiteLayout>
