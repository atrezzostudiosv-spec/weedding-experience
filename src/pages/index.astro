---
import SiteLayout from "../layouts/SiteLayout.astro";
import PrimaryAction from "../components/PrimaryAction.astro";
import {images} from "../data/site.js";
const base = import.meta.env.BASE_URL;
---
<SiteLayout title="Every Celebration Begins With A Feeling" description="An editorial concept for wedding planning and event design by Atrezzo Studios." page="home" homeScroll={true}>
  <section class="hero hero--video" aria-label="Wedding ceremony film">
    <div class="hero__media" aria-hidden="true">
      <img class="hero__poster" src={base + "assets/video/wedding-hero-poster.jpg"} alt="" fetchpriority="high" decoding="async" />
      <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster={base + "assets/video/wedding-hero-poster.jpg"} aria-hidden="true" tabindex="-1">
        <source src={base + "assets/video/wedding-hero-preview.mp4"} type="video/mp4" />
      </video>
    </div>
  </section>
  <section class="home-intro" id="our-perspective" aria-labelledby="intro-title">
    <span class="section-label"><span class="gold-line"></span> THE POINT OF VIEW / 01</span>
    <h1 id="intro-title">It’s never just<br/><em>about the day.</em></h1>
    <div class="home-intro__foot"><p>It’s the anticipation before a room fills. The familiar faces. The conversations that continue long after the final dance. Beautiful celebrations begin with the people and feelings at their heart.</p><PrimaryAction href={base + "about/"} label="Our perspective" subtle /></div>
  </section>
  <div class="ats-scope wedding-scroll" id="wedding-expand">
    <section class="ats-scene ats-scene--expand" data-ats-effect="expand" aria-labelledby="wedding-expand-title">
      <div class="ats-stage">
        <div class="ats-center-photo ats-photo"><img src={images.expand} alt="Floral ceremony arch surrounded by white chairs; illustrative reference photography." loading="lazy" decoding="async" /></div>
        <div class="ats-scene__bar"><strong>THE EXPERIENCE / 02</strong><span>SCULPTED BY THE MOMENT</span></div>
        <div class="ats-title-overlay"><h2 id="wedding-expand-title">For the moments<br/><em>that matter.</em></h2><p>A celebration begins with a feeling — and grows through a thousand thoughtful details.</p></div>
      </div>
    </section>
  </div>
  <section class="home-closing" aria-labelledby="closing-title">
    <div class="home-closing__index"><span class="section-label">A PERSONAL INVITATION / 03</span><span class="gold-star" aria-hidden="true">✳</span></div>
    <div class="home-closing__body">
      <h2 id="closing-title">Your story deserves<br/>a beautiful setting.</h2>
      <p>Explore the vision behind this concept, or begin a conversation about an occasion worth remembering.</p>
      <PrimaryAction href={base + "services/"} label="Explore the services" />
    </div>
  </section>
</SiteLayout>
