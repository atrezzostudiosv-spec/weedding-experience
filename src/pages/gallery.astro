---
import SiteLayout from '../layouts/SiteLayout.astro';
import PrimaryAction from '../components/PrimaryAction.astro';
import { frontmatter as copy } from '../../docs/GALLERY-EDITORIAL-MASTER.md';
import { editorialMedia as media } from '../data/editorial-media.js';
import '../styles/editorial-internal.css';
import '../styles/gallery.css';

const base = import.meta.env.BASE_URL;
---
<SiteLayout title={copy.title} description={copy.intro} page="gallery" editorialMotion>
  <header class="gallery-opening">
    <div class="gallery-opening__image" data-am-parallax><img src={media.table.src} alt={media.table.alt} fetchpriority="high" /></div>
    <div class="gallery-opening__type">
      <span class="section-label">{copy.label}</span>
      <h1 class="inner-display">{copy.opening}<br/><em data-am-text>{copy.openingEmphasis}</em></h1>
    </div>
  </header>
  <div class="gallery-preface inner-wrap">
    <p class="gallery-preface__lead">{copy.intro}</p>
    <p>{copy.disclosure}</p>
  </div>
  <div class="gallery-editorial inner-wrap">
    <nav class="gallery-index" aria-label="Browse editorial concepts">
      {copy.chapters.map((chapter, i) => (
        <a href={'#' + chapter.id} aria-current={i === 0 ? 'location' : undefined}>{chapter.title}</a>
      ))}
    </nav>
    <div class="gallery-collection">
      {copy.chapters.map((chapter) => (
        <section class:list={['gallery-chapter', 'gallery-chapter--' + chapter.id]} id={chapter.id} aria-labelledby={chapter.id + '-title'}>
          <header>
            <h2 id={chapter.id + '-title'} class="inner-display" data-am-text>{chapter.title}</h2>
            <p>{chapter.copy}</p>
          </header>
          <div class="gallery-chapter__photos">
            {chapter.photos.map((key, index) => (
              <figure class:list={['gallery-figure', `gallery-figure--${index + 1}`]}>
                <a href={media[key].src} class="gallery-photo" data-gallery-photo data-caption={chapter.captions[index]} data-category={chapter.title} aria-label={'Enlarge photograph: ' + chapter.captions[index]}>
                  <span class="gallery-photo__crop" data-am-parallax>
                    <img src={media[key].src} alt={media[key].alt} loading="lazy" decoding="async" />
                  </span>
                  <span class="gallery-photo__open" aria-hidden="true">↗</span>
                </a>
                <figcaption>{chapter.captions[index]}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
  <dialog class="gallery-dialog" aria-labelledby="gallery-dialog-title">
    <div class="gallery-dialog__bar">
      <p id="gallery-dialog-title" data-gallery-title>Editorial photograph</p>
      <button type="button" data-gallery-close autofocus>Close <span aria-hidden="true">×</span></button>
    </div>
    <figure><img data-gallery-image alt="" /><figcaption data-gallery-caption aria-live="polite"></figcaption></figure>
    <div class="gallery-dialog__controls" aria-label="Photograph controls">
      <button type="button" data-gallery-prev>← <span class="sr-only">Previous photograph</span></button>
      <span data-gallery-position></span>
      <button type="button" data-gallery-next><span class="sr-only">Next photograph</span> →</button>
    </div>
  </dialog>
  <section class="inner-invitation" aria-labelledby="gallery-invitation">
    <h2 class="inner-display" id="gallery-invitation">{copy.closingTitle}</h2>
    <p>{copy.closing}</p>
    <PrimaryAction href={base + 'contact/'} label={copy.cta} />
  </section>
</SiteLayout>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-photo]')];
  const dialog = document.querySelector<HTMLDialogElement>('.gallery-dialog');
  if (dialog && typeof dialog.showModal === 'function' && links.length) {
    const picture = dialog.querySelector<HTMLImageElement>('[data-gallery-image]')!;
    const title = dialog.querySelector('[data-gallery-title]')!;
    const caption = dialog.querySelector('[data-gallery-caption]')!;
    const position = dialog.querySelector('[data-gallery-position]')!;
    let opener: HTMLAnchorElement;
    let index = 0;
    let transition: Animation | undefined;
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let start: { x: number; y: number } | undefined;

    function showPhoto(i: number) {
      index = (i + links.length) % links.length;
      const link = links[index];
      picture.src = link.href;
      picture.alt = link.querySelector('img')?.alt ?? '';
      title.textContent = link.dataset.category ?? '';
      caption.textContent = link.dataset.caption ?? '';
      position.textContent = `${index + 1} / ${links.length}`;
      transition?.cancel();
      if (dialog.open && !reduceMotion.matches) {
        transition = picture.animate([{ opacity: 0.35 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' });
      }
    }

    links.forEach((link, i) => link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      opener = link;
      showPhoto(i);
      dialog.showModal();
    }));
    dialog.querySelector('[data-gallery-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-gallery-prev]')?.addEventListener('click', () => showPhoto(index - 1));
    dialog.querySelector('[data-gallery-next]')?.addEventListener('click', () => showPhoto(index + 1));
    dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      showPhoto(index + (event.key === 'ArrowRight' ? 1 : -1));
    });
    picture.addEventListener('touchstart', (event) => {
      const touch = event.touches[0];
      start = event.touches.length === 1 ? { x: touch.clientX, y: touch.clientY } : undefined;
    }, { passive: true });
    picture.addEventListener('touchend', (event) => {
      if (!start) return;
      const touch = event.changedTouches[0];
      const dx = touch.clientX - start.x;
      const dy = touch.clientY - start.y;
      start = undefined;
      if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.4) showPhoto(index + (dx < 0 ? 1 : -1));
    }, { passive: true });
    picture.addEventListener('touchcancel', () => { start = undefined; });
  }

  const anchors = [...document.querySelectorAll<HTMLAnchorElement>('.gallery-index a')];
  const chapters = [...document.querySelectorAll<HTMLElement>('.gallery-chapter')];
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const current = entries.find((entry) => entry.isIntersecting);
      if (!current) return;
      for (const anchor of anchors) {
        if (anchor.hash === '#' + current.target.id) anchor.setAttribute('aria-current', 'location');
        else anchor.removeAttribute('aria-current');
      }
    }, { rootMargin: '-22% 0px -60% 0px' });
    chapters.forEach((chapter) => observer.observe(chapter));
  }
</script>
